void servo_ve_giua() {
  servoDau.write(GOC_GIUA);
  servoTayTrai.write(GOC_GIUA);
  servoTayPhai.write(GOC_GIUA);
}

void nhin_trai() {
  Serial.println("Robot: NHIN_TRAI");
  ve_mat_liec_trai();
  servoDau.write(DAU_TRAI);
  delay(600);
}

void nhin_phai() {
  Serial.println("Robot: NHIN_PHAI");
  ve_mat_liec_phai();
  servoDau.write(DAU_PHAI);
  delay(600);
}

void nhin_thang() {
  Serial.println("Robot: NHIN_THANG");
  servo_ve_giua();
  can_ve_lai_ngay = true;
}

void lac_dau() {
  Serial.println("Robot: LAC_DAU");
  for (int i = 0; i < 3; i++) {
    ve_mat_liec_trai();
    servoDau.write(DAU_TRAI);
    delay(300);

    ve_mat_liec_phai();
    servoDau.write(DAU_PHAI);
    delay(300);
  }

  servoDau.write(GOC_GIUA);
  can_ve_lai_ngay = true;
}

void vay_tay_trai() {
  Serial.println("Robot: VAY_TAY_TRAI");
  for (int i = 0; i < 3; i++) {
    servoTayTrai.write(TAY_TRAI_LEN);
    delay(250);

    servoTayTrai.write(TAY_TRAI_XUONG);
    delay(250);
  }

  servoTayTrai.write(GOC_GIUA);
}

void vay_tay_phai() {
  Serial.println("Robot: VAY_TAY_PHAI");

  for (int i = 0; i < 3; i++) {
    servoTayPhai.write(TAY_PHAI_LEN);
    delay(250);

    servoTayPhai.write(TAY_PHAI_XUONG);
    delay(250);
  }

  servoTayPhai.write(GOC_GIUA);
}

void vay_hai_tay() {
  Serial.println("Robot: VAY_HAI_TAY");
  for (int i = 0; i < 4; i++) {
    servoTayTrai.write(TAY_TRAI_LEN);
    servoTayPhai.write(TAY_PHAI_LEN);
    delay(250);

    servoTayTrai.write(TAY_TRAI_XUONG);
    servoTayPhai.write(TAY_PHAI_XUONG);
    delay(250);
  }

  servoTayTrai.write(GOC_GIUA);
  servoTayPhai.write(GOC_GIUA);
}

void chao_robot() {
  Serial.println("Robot: CHAO");
  servo_ve_giua();
  delay(150);
  ve_mat_mo();
  servoDau.write(DAU_TRAI);
  delay(250);
  servoDau.write(DAU_PHAI);
  delay(250);
  servoDau.write(GOC_GIUA);
  delay(200);
  for (int i = 0; i < 3; i++) {
    servoTayTrai.write(TAY_TRAI_LEN);
    servoTayPhai.write(TAY_PHAI_LEN);
    digitalWrite(LED_PIN, HIGH);
    delay(250);

    servoTayTrai.write(TAY_TRAI_XUONG);
    servoTayPhai.write(TAY_PHAI_XUONG);
    digitalWrite(LED_PIN, LOW);
    delay(250);
  }

  servo_ve_giua();
  can_ve_lai_ngay = true;
}

void hien_thi_oled_text(String noi_dung) {
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  display.setTextSize(1);
  display.setCursor(0, 0);
  display.println("THONG BAO:");
  display.drawLine(0, 11, 128, 11, SSD1306_WHITE);

  int y = 16;
  int start = 0;
  while (start < noi_dung.length() && y <= 56) {
    String dong = noi_dung.substring(start, min(start + 20, (int)noi_dung.length()));
    display.setCursor(0, y);
    display.println(dong);
    start += 20;
    y += 10;
  }
  display.display();
}

void xu_ly_lenh_robot(String lenh) {
  lenh.trim();
  if (lenh.length() == 0 || lenh == "NONE" || lenh == "null") return;
  if (lenh.startsWith("OLED:")) {
    String nd = lenh.substring(5);
    nd.trim();
    hien_thi_oled_text(nd);
    lenh_robot_cu = lenh;
    return;
  }

  if (lenh.startsWith("EMOTION:")) {
    String cx = lenh.substring(8);
    cx.trim();
    if (cx == "TRAI")
      ve_mat_liec_trai();
    else if (cx == "PHAI")
      ve_mat_liec_phai();
    else if (cx == "LEN")
      ve_mat_liec_len();
    else if (cx == "NHAM")
      ve_mat_nham();
    else
      ve_mat_mo();
    lenh_robot_cu = lenh;
    return;
  }

  if (lenh == "DUNG" || lenh == "NHIN_THANG") {
    nhin_thang();
  } else if (lenh == "CHAO") {
    chao_robot();
  } else if (lenh == "VAY_TAY_TRAI") {
    vay_tay_trai();
  } else if (lenh == "VAY_TAY_PHAI") {
    vay_tay_phai();
  } else if (lenh == "VAY_HAI_TAY") {
    vay_hai_tay();
  } else if (lenh == "LAC_DAU") {
    lac_dau();
  } else if (lenh == "NHIN_TRAI" || lenh == "QUAY_DAU_TRAI") {
    nhin_trai();
  } else if (lenh == "NHIN_PHAI" || lenh == "QUAY_DAU_PHAI") {
    nhin_phai();
  } else if (lenh == "POMODORO" || lenh == "BAT_DAU_HOC") {
    bat_dau_pomodoro_lam_viec();
  } else if (lenh == "DUNG_HOC") {
    ket_thuc_pomodoro();
  } else if (lenh == "MOI_TRUONG") {
    trang_thai_man_hinh = 1;
    can_ve_lai_ngay = true;
  } else {
    Serial.print("Lenh khong hop le: ");
    Serial.println(lenh);
  }

  dat_lai_may_trang_thai_ranh();
}

bool la_lenh_hop_le_can_xu_ly(String lenh) {
  lenh.trim();
  return lenh.length() > 0 && lenh != "NONE" && lenh != "null";
}

void ghi_command_ack(String requestId, String lenh, String status, unsigned long long espReceivedAt,
                     unsigned long long espExecutedAt) {
  if (!Firebase.ready() || requestId.length() == 0) return;

  Firebase.RTDB.setString(&fbdo, fbPath("/ThietBi/CommandAck/requestId"), requestId);
  Firebase.RTDB.setString(&fbdo, fbPath("/ThietBi/CommandAck/command"), lenh);
  Firebase.RTDB.setString(&fbdo, fbPath("/ThietBi/CommandAck/status"), status);
  Firebase.RTDB.setString(&fbdo, fbPath("/ThietBi/CommandAck/espReceivedAt"),
                          epochMsToString(espReceivedAt));
  Firebase.RTDB.setString(&fbdo, fbPath("/ThietBi/CommandAck/espExecutedAt"),
                          epochMsToString(espExecutedAt));
  Firebase.RTDB.setString(&fbdo, fbPath("/ThietBi/CommandAck/robotId"), ROBOT_ID);
  Firebase.RTDB.setString(&fbdo, fbPath("/ThietBi/CommandAck/updatedAt"), nowEpochMsString());
}

void doc_lenh_robot_tu_firebase() {
  if (!Firebase.ready()) return;
  if (millis() - thoi_gian_doc_lenh_robot < 300) return;
  thoi_gian_doc_lenh_robot = millis();

  String lenh = "";
  String requestId = "";
  bool co_command_request_moi = false;

  // CommandRequest chứa requestId và webSentAt để đo độ trễ.
  if (Firebase.RTDB.getString(&fbdo, fbPath("/ThietBi/CommandRequest/requestId"))) {
    requestId = fbdo.stringData();
    requestId.trim();

    if (requestId.length() > 0 && requestId != command_request_id_cu) {
      if (Firebase.RTDB.getString(&fbdo, fbPath("/ThietBi/CommandRequest/command"))) {
        lenh = fbdo.stringData();
        lenh.trim();
        if (la_lenh_hop_le_can_xu_ly(lenh)) {
          co_command_request_moi = true;
        }
      }
    }
  }

  // Đọc LenhDieuKhien để tương thích với dashboard cũ.
  if (!co_command_request_moi) {
    if (Firebase.RTDB.getString(&fbdo, fbPath("/ThietBi/LenhDieuKhien"))) {
      lenh = fbdo.stringData();
      lenh.trim();
    }
  }

  if (!la_lenh_hop_le_can_xu_ly(lenh)) return;

  unsigned long long espReceivedAt = getEpochMs();

  Serial.print("Lenh robot Firebase: ");
  Serial.println(lenh);
  if (co_command_request_moi) {
    Serial.print("CommandRequest ID: ");
    Serial.println(requestId);
  }

  if (Firebase.ready()) {
    Firebase.RTDB.setString(&fbdo, fbPath("/ThietBi/CheDo"), "DANG_CHAY");
    Firebase.RTDB.setString(&fbdo, fbPath("/ThietBi/LenhDangChay"), lenh);
    Firebase.RTDB.setString(&fbdo, fbPath("/ThietBi/ThoiGianNhanLenh"),
                            epochMsToString(espReceivedAt));

    if (co_command_request_moi) {
      Firebase.RTDB.setString(&fbdo, fbPath("/ThietBi/CommandRequest/status"), "RECEIVED_BY_ESP32");
      Firebase.RTDB.setString(&fbdo, fbPath("/ThietBi/CommandRequest/espReceivedAt"),
                              epochMsToString(espReceivedAt));
    }
  }

  dat_lai_may_trang_thai_ranh();
  xu_ly_lenh_robot(lenh);

  unsigned long long espExecutedAt = getEpochMs();

  lenh_robot_cu = lenh;
  if (co_command_request_moi) {
    command_request_id_cu = requestId;
    ghi_command_ack(requestId, lenh, "DONE", espReceivedAt, espExecutedAt);
  }

  if (Firebase.ready()) {
    Firebase.RTDB.setString(&fbdo, fbPath("/ThietBi/LenhCuoi"), lenh);
    Firebase.RTDB.setString(&fbdo, fbPath("/ThietBi/LenhDangChay"), "NONE");
    Firebase.RTDB.setString(&fbdo, fbPath("/ThietBi/CheDo"), "IDLE");
    Firebase.RTDB.setString(&fbdo, fbPath("/ThietBi/LenhDieuKhien"), "NONE");
    Firebase.RTDB.setString(&fbdo, fbPath("/ThietBi/ThoiGianCapNhat"), nowEpochMsString());
  }
}

void setup() {
  Serial.begin(115200);
  delay(1000);
  randomSeed((uint32_t)(micros() ^ analogRead(34)));

  Serial.println();
  Serial.println("BAT DAU KHOI DONG ESP32");
  pinMode(TOUCH_PIN, INPUT_PULLDOWN);
  pinMode(BUZZER_PIN, OUTPUT);
  pinMode(LED_PIN, OUTPUT);
  digitalWrite(BUZZER_PIN, LOW);
  digitalWrite(LED_PIN, LOW);

  // Khởi tạo I2C và OLED trước khi vẽ hoặc chạy servo.
  Wire.begin(21, 22);
  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println("Loi OLED 0x3C. Thu dia chi 0x3D neu can.");
    while (true) {
      delay(1000);
    }
  }

  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
  display.setCursor(0, 20);
  display.println("Khoi dong ESP32...");
  display.display();
  Serial.println("OLED OK");

  if (!aht.begin()) {
    Serial.println("Loi AHT20!");
  } else {
    Serial.println("AHT20 OK");
  }

  if (bmp.begin(0x76)) {
    Serial.println("BMP280 OK 0x76");
  } else if (bmp.begin(0x77)) {
    Serial.println("BMP280 OK 0x77");
  } else {
    Serial.println("Loi BMP280!");
  }

  if (!lightMeter.begin()) {
    Serial.println("Loi BH1750!");
  } else {
    Serial.println("BH1750 OK");
  }

  // Khởi tạo servo sau OLED để tránh StoreProhibited.
  servoDau.setPeriodHertz(50);
  servoTayTrai.setPeriodHertz(50);
  servoTayPhai.setPeriodHertz(50);

  servoDau.attach(SERVO_DAU_PIN, 500, 2500);
  servoTayTrai.attach(SERVO_TAY_TRAI_PIN, 500, 2500);
  servoTayPhai.attach(SERVO_TAY_PHAI_PIN, 500, 2500);

  servo_ve_giua();
  Serial.println("Servo OK");

  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
  display.setCursor(10, 30);
  display.print("Dang noi WiFi...");
  display.display();

  WiFi.begin(ssid, password);
  Serial.print("Dang ket noi WiFi");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\nWiFi OK!");
  Serial.println("================================");
  Serial.print("DIA CHI IP ESP32: ");
  Serial.println(WiFi.localIP());
  Serial.println("================================");

  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
  display.setCursor(0, 0);
  display.println("WiFi OK");
  display.println("IP ESP32:");
  display.println(WiFi.localIP());
  display.display();
  delay(2000);

  // Độ trễ dùng epoch UTC; OLED hiển thị giờ Việt Nam.
  configTime(0, 0, "pool.ntp.org", "time.nist.gov");
  setenv("TZ", "ICT-7", 1);
  tzset();
  struct tm timeInfo;
  if (getLocalTime(&timeInfo, 10000)) {
    Serial.println("Da dong bo NTP UTC + hien thi gio Viet Nam!");
  } else {
    Serial.println("Canh bao: chua dong bo duoc NTP, lan do do tre dau tien co the bi bo qua.");
  }

  config.api_key = API_KEY;
  config.database_url = DATABASE_URL;
  config.token_status_callback = tokenStatusCallback;
  if (Firebase.signUp(&config, &auth, "", "")) {
    Serial.println("Firebase signUp OK!");
  } else {
    Serial.print("Firebase signUp loi: ");
    Serial.println(config.signer.signupError.message.c_str());
  }

  Firebase.begin(&config, &auth);
  Firebase.reconnectWiFi(true);
  Serial.println("Firebase dang khoi tao...");
  if (Firebase.ready()) {
    Firebase.RTDB.setString(&fbdo, fbPath("/ThietBi/TenThietBi"), "DeskRobot_ESP32");
    Firebase.RTDB.setString(&fbdo, fbPath("/ThietBi/RobotId"), ROBOT_ID);
    Firebase.RTDB.setString(&fbdo, fbPath("/ThietBi/TrangThai"), "ONLINE");
    Firebase.RTDB.setString(&fbdo, fbPath("/ThietBi/CheDo"), "IDLE");
    Firebase.RTDB.setString(&fbdo, fbPath("/ThietBi/IP"), WiFi.localIP().toString());
    Firebase.RTDB.setString(&fbdo, fbPath("/Dashboard/CheDoDieuKhien"), "FIREBASE");
    Firebase.RTDB.setString(&fbdo, fbPath("/ThietBi/LenhDangChay"), "NONE");
    Firebase.RTDB.setString(&fbdo, fbPath("/ThietBi/LenhCuoi"), "NONE");
    Firebase.RTDB.setString(&fbdo, fbPath("/ThietBi/LenhDieuKhien"), "NONE");

    // Đọc requestId hiện tại để tránh lặp lệnh sau khi reset.
    Firebase.RTDB.setString(&fbdo, fbPath("/ThietBi/CommandAck/status"), "READY");
    if (Firebase.RTDB.getString(&fbdo, fbPath("/ThietBi/CommandRequest/requestId"))) {
      command_request_id_cu = fbdo.stringData();
      command_request_id_cu.trim();
    }

    Firebase.RTDB.setString(&fbdo, fbPath("/RobotInfo/robotId"), ROBOT_ID);
    Firebase.RTDB.setString(&fbdo, fbPath("/RobotInfo/name"), "DeskRobot_ESP32");
    Firebase.RTDB.setString(&fbdo, fbPath("/RobotInfo/status"), "ONLINE");
    Firebase.RTDB.setString(&fbdo, fbPath("/RobotInfo/ip"), WiFi.localIP().toString());
    Firebase.RTDB.setInt(&fbdo, fbPath("/RobotInfo/lastSeen"), (int)time(nullptr));
  }

  can_ve_lai_ngay = true;
  dat_lai_may_trang_thai_ranh();

  chao_robot();

  Serial.println("HE THONG SAN SANG");
}


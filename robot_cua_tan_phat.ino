bool duoc_chay_kich_ban_ranh() {
  if (trang_thai_man_hinh != 0) return false;
  if (pomodoro_dang_chay) return false;
  if (trang_thai_vui_d4 != VUI_D4_RANH) return false;
  return true;
}

void dat_lai_may_trang_thai_ranh() {
  trang_thai_ranh = RANH_CHO;
  kich_ban_ranh = 0;
  moc_thoi_gian_ranh = millis();
  thoi_gian_cho_ranh = random(5000, 10001);  // 5 den 10 giay
  moc_buoc_ranh = millis();
  // Giữ vị trí servo khi đang chạy hiệu ứng vui D4.
  if (trang_thai_vui_d4 == VUI_D4_RANH) {
    servo_ve_giua();
  }
}

void bat_dau_kich_ban_ranh() {
  kich_ban_ranh = random(1, 4);
  // Kịch bản: 1 = tò mò, 2 = vui, 3 = buồn chán.
  moc_buoc_ranh = millis();

  Serial.print("Bat dau kich ban ranh: ");
  Serial.println(kich_ban_ranh);
  if (kich_ban_ranh == 1) {
    trang_thai_ranh = KB_A_LIEC_TRAI;
    ve_mat_liec_trai();
    servoTayPhai.write(65);
    servoTayTrai.write(90);
  } else if (kich_ban_ranh == 2) {
    trang_thai_ranh = KB_B_CHOP_1;
    ve_mat_nham();
    servoTayTrai.write(70);
  } else {
    trang_thai_ranh = KB_C_LIEC_LEN;
    ve_mat_liec_len();
    servo_ve_giua();
  }
}

// Chuyển trạng thái bằng millis() để tránh chặn vòng lặp.
void xu_ly_may_trang_thai_ranh() {
  if (!duoc_chay_kich_ban_ranh()) {
    dat_lai_may_trang_thai_ranh();
    return;
  }

  unsigned long now = millis();

  switch (trang_thai_ranh) {
    case RANH_CHO:
      if (moc_thoi_gian_ranh == 0) dat_lai_may_trang_thai_ranh();
      if (now - moc_thoi_gian_ranh >= thoi_gian_cho_ranh) {
        bat_dau_kich_ban_ranh();
      }
      break;

    case KB_A_LIEC_TRAI:
      if (now - moc_buoc_ranh >= 1000) {
        trang_thai_ranh = KB_A_LIEC_PHAI;
        moc_buoc_ranh = now;
        ve_mat_liec_phai();
        servoTayPhai.write(115);
        servoTayTrai.write(90);
      }
      break;
    case KB_A_LIEC_PHAI:
      if (now - moc_buoc_ranh >= 1000) {
        can_ve_lai_ngay = true;
        dat_lai_may_trang_thai_ranh();
      }
      break;

    case KB_B_CHOP_1:
      if (now - moc_buoc_ranh >= 130) {
        trang_thai_ranh = KB_B_MO_1;
        moc_buoc_ranh = now;
        ve_mat_mo();
        servoTayTrai.write(110);
      }
      break;
    case KB_B_MO_1:
      if (now - moc_buoc_ranh >= 130) {
        trang_thai_ranh = KB_B_CHOP_2;
        moc_buoc_ranh = now;
        ve_mat_nham();
      }
      break;
    case KB_B_CHOP_2:
      if (now - moc_buoc_ranh >= 130) {
        trang_thai_ranh = KB_B_MO_2;
        moc_buoc_ranh = now;
        ve_mat_mo();
        servoTayTrai.write(90);
      }
      break;
    case KB_B_MO_2:
      if (now - moc_buoc_ranh >= 350) {
        can_ve_lai_ngay = true;
        dat_lai_may_trang_thai_ranh();
      }
      break;

    case KB_C_LIEC_LEN:
      if (now - moc_buoc_ranh >= 2000) {
        can_ve_lai_ngay = true;
        dat_lai_may_trang_thai_ranh();
      }
      break;
  }
}

void bat_dau_vui_d4() {
  trang_thai_vui_d4 = VUI_D4_VAY_DUOI;
  moc_vui_d4 = millis();
  moc_vay_duoi_vui_d4 = millis();
  goc_duoi_vui_d4 = 70;

  // Tạm dừng kịch bản ngẫu nhiên khi hiệu ứng D4 đang chạy.
  trang_thai_ranh = RANH_CHO;
  ve_mat_liec_len();
  servoTayPhai.write(90);
  servoTayTrai.write(goc_duoi_vui_d4);

  Serial.println("D4: VUI VE");
}

void xu_ly_vui_d4() {
  unsigned long now = millis();
  // Chỉ chuyển động servo khi D4 còn được giữ.
  if (trang_thai_vui_d4 == VUI_D4_VAY_DUOI) {
    if (digitalRead(TOUCH_PIN) == LOW) {
      trang_thai_vui_d4 = VUI_D4_THA_NHIN_LEN;
      moc_vui_d4 = now;
      ve_mat_liec_len();
      servoTayTrai.write(90);  // dung vay, dua duoi ve giua
      servoTayPhai.write(90);
      return;
    }

    if (now - moc_vay_duoi_vui_d4 >= 180) {
      moc_vay_duoi_vui_d4 = now;
      if (goc_duoi_vui_d4 == 60) {
        goc_duoi_vui_d4 = 120;
      } else {
        goc_duoi_vui_d4 = 60;
      }

      servoTayTrai.write(goc_duoi_vui_d4);
      Serial.print("Vay duoi D4: ");
      Serial.println(goc_duoi_vui_d4);
    }
  }
  // Thả D4: dừng servo, nhìn lên 3 giây rồi về trạng thái mặc định.
  else if (trang_thai_vui_d4 == VUI_D4_THA_NHIN_LEN) {
    if (now - moc_vui_d4 >= 3000) {
      trang_thai_vui_d4 = VUI_D4_RANH;
      servo_ve_giua();
      can_ve_lai_ngay = true;
      dat_lai_may_trang_thai_ranh();
    }
  }
}

void hen_lan_chop_tiep_theo() {
  int kieu = random(0, 100);
  if (kieu < 12) {
    mat_thoi_gian_cho = random(450, 1200);
  } else if (kieu < 75) {
    mat_thoi_gian_cho = random(1800, 5200);
  } else {
    mat_thoi_gian_cho = random(6000, 9500);
  }

  thoi_gian_truoc_mat = millis();
  trang_thai_mat = 0;
}

void bat_dau_chop_mat() {
  int kieu = random(0, 100);
  if (kieu < 68) {
    mat_so_lan_chop_con_lai = 1;
  } else if (kieu < 90) {
    mat_so_lan_chop_con_lai = 2;
  } else {
    mat_so_lan_chop_con_lai = 3;
  }

  ve_mat_nham();
  if (random(0, 100) < 12) {
    mat_thoi_gian_cho = random(350, 850);
  } else {
    mat_thoi_gian_cho = random(85, 180);
  }

  thoi_gian_truoc_mat = millis();
  trang_thai_mat = 1;
}

void hieu_ung_nhay_mat() {
  unsigned long t_hien_tai = millis();

  if (can_ve_lai_ngay) {
    ve_mat_mo();
    can_ve_lai_ngay = false;
    mat_so_lan_chop_con_lai = 0;
    hen_lan_chop_tiep_theo();
    return;
  }

  switch (trang_thai_mat) {
    case 0:  // Mat dang mo, cho den lan chop tiep theo
      if (t_hien_tai - thoi_gian_truoc_mat >= mat_thoi_gian_cho) {
        bat_dau_chop_mat();
      }
      break;

    case 1:  // Mat dang nham
      if (t_hien_tai - thoi_gian_truoc_mat >= mat_thoi_gian_cho) {
        ve_mat_mo();
        mat_so_lan_chop_con_lai--;

        if (mat_so_lan_chop_con_lai > 0) {
          mat_thoi_gian_cho = random(70, 220);
          thoi_gian_truoc_mat = t_hien_tai;
          trang_thai_mat = 2;
        } else {
          hen_lan_chop_tiep_theo();
        }
      }
      break;
    case 2:  // Khoang mo ngan giua cac lan chop lien tuc
      if (t_hien_tai - thoi_gian_truoc_mat >= mat_thoi_gian_cho) {
        ve_mat_nham();
        mat_thoi_gian_cho = random(80, 170);
        thoi_gian_truoc_mat = t_hien_tai;
        trang_thai_mat = 1;
      }
      break;
  }
}

void hien_thi_thoi_tiet() {
  if (millis() - thoi_gian_cap_nhat_cam_bien > 1000 || can_ve_lai_ngay) {
    thoi_gian_cap_nhat_cam_bien = millis();
    can_ve_lai_ngay = false;

    sensors_event_t humidity, temp;
    aht.getEvent(&humidity, &temp);

    float nhietDo = temp.temperature;
    float doAm = humidity.relative_humidity;
    float anhSang = lightMeter.readLightLevel();
    struct tm thoi_gian;
    bool co_gio = getLocalTime(&thoi_gian);

    display.clearDisplay();
    display.setTextColor(SSD1306_WHITE);

    display.setTextSize(1);
    display.setCursor(0, 0);
    if (co_gio) {
      display.print(&thoi_gian, "%d/%m/%Y");
      display.setCursor(78, 0);
      display.print(&thoi_gian, "%H:%M");
    } else {
      display.print("Dang lay gio NTP");
    }

    display.drawLine(0, 10, 127, 10, SSD1306_WHITE);
    display.setCursor(20, 14);
    display.print("MOI TRUONG");

    display.setCursor(0, 28);
    display.print("Nhiet do: ");
    if (isfinite(nhietDo)) {
      display.print(nhietDo, 1);
      display.print(" C");
    } else {
      display.print("--.- C");
    }

    display.setCursor(0, 40);
    display.print("Do am   : ");
    if (isfinite(doAm)) {
      display.print(doAm, 0);
      display.print(" %");
    } else {
      display.print("-- %");
    }

    display.setCursor(0, 52);
    display.print("Lux:");
    if (isfinite(anhSang)) {
      display.print(anhSang, 0);
    } else {
      display.print("--");
    }
    display.setCursor(78, 52);
    display.print(Firebase.ready() ? "FB:OK" : "FB:...");

    display.display();
  }
}

void hien_thi_dong_ho() {
  if (millis() - thoi_gian_cap_nhat_gio > 1000 || can_ve_lai_ngay) {
    thoi_gian_cap_nhat_gio = millis();
    can_ve_lai_ngay = false;

    struct tm thoi_gian;
    if (!getLocalTime(&thoi_gian)) {
      display.clearDisplay();
      display.setCursor(15, 30);
      display.print("Dang lay gio...");
      display.display();
      return;
    }

    display.clearDisplay();
    display.setTextColor(SSD1306_WHITE);
    display.setTextSize(3);
    display.setCursor(20, 15);
    display.print(&thoi_gian, "%H:%M");
    display.setTextSize(1);
    display.setCursor(30, 50);
    display.print(&thoi_gian, "%d/%m/%Y");

    display.display();
  }
}

unsigned long pomodoro_giay_con_lai() {
  if (!pomodoro_dang_chay) return 0;
  unsigned long da_chay = (millis() - pomodoro_bat_dau_ms) / 1000UL;
  if (da_chay >= pomodoro_tong_giay) return 0;
  return pomodoro_tong_giay - da_chay;
}

void gui_trang_thai_pomodoro_firebase(const char* trang_thai, unsigned long con_lai, bool dang_chay,
                                      bool dang_nghi) {
  if (!Firebase.ready()) return;

  Firebase.RTDB.setString(&fbdo, fbPath("/Pomodoro/trangThai"), trang_thai);
  Firebase.RTDB.setBool(&fbdo, fbPath("/Pomodoro/dangChay"), dang_chay);
  Firebase.RTDB.setBool(&fbdo, fbPath("/Pomodoro/dangNghi"), dang_nghi);
  Firebase.RTDB.setInt(&fbdo, fbPath("/Pomodoro/conLaiGiay"), con_lai);
  Firebase.RTDB.setInt(&fbdo, fbPath("/Pomodoro/tongGiay"), pomodoro_tong_giay);

  int phan_tram = 0;
  if (pomodoro_tong_giay > 0) {
    phan_tram = (int)((pomodoro_tong_giay - con_lai) * 100UL / pomodoro_tong_giay);
  }
  Firebase.RTDB.setInt(&fbdo, fbPath("/Pomodoro/phanTram"), phan_tram);
  Firebase.RTDB.setInt(&fbdo, fbPath("/Pomodoro/updatedAt"), (int)time(nullptr));
}

void canh_bao_het_gio() {
  for (int i = 0; i < 5; i++) {
    digitalWrite(LED_PIN, HIGH);
    digitalWrite(BUZZER_PIN, HIGH);
    delay(180);
    digitalWrite(LED_PIN, LOW);
    digitalWrite(BUZZER_PIN, LOW);
    delay(180);
  }
}

void bat_dau_pomodoro_lam_viec() {
  pomodoro_dang_chay = true;
  pomodoro_dang_nghi = false;
  pomodoro_tong_giay = POMODORO_WORK_SECONDS;
  pomodoro_bat_dau_ms = millis();
  pomodoro_giay_con_lai_cu = -1;
  trang_thai_man_hinh = 3;
  can_ve_lai_ngay = true;

  gui_trang_thai_pomodoro_firebase("WORK", POMODORO_WORK_SECONDS, true, false);
  Serial.println("Pomodoro bat dau: 25 phut hoc tap");
}

void bat_dau_pomodoro_nghi() {
  pomodoro_dang_chay = true;
  pomodoro_dang_nghi = true;
  pomodoro_tong_giay = POMODORO_BREAK_SECONDS;
  pomodoro_bat_dau_ms = millis();
  pomodoro_giay_con_lai_cu = -1;
  trang_thai_man_hinh = 3;
  can_ve_lai_ngay = true;

  gui_trang_thai_pomodoro_firebase("BREAK", POMODORO_BREAK_SECONDS, true, true);
  Serial.println("Pomodoro nghi: 5 phut");
}

void ket_thuc_pomodoro() {
  pomodoro_dang_chay = false;
  pomodoro_dang_nghi = false;
  pomodoro_giay_con_lai_cu = -1;
  can_ve_lai_ngay = true;

  gui_trang_thai_pomodoro_firebase("DONE", 0, false, false);
  Serial.println("Pomodoro hoan tat!");
  canh_bao_het_gio();
}

void hien_thi_pomodoro() {
  if (millis() - thoi_gian_ve_pomodoro < 500 && !can_ve_lai_ngay) return;
  thoi_gian_ve_pomodoro = millis();
  can_ve_lai_ngay = false;

  unsigned long con_lai = pomodoro_giay_con_lai();
  int phut = con_lai / 60;
  int giay = con_lai % 60;
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);

  display.setTextSize(1);
  display.setCursor(0, 0);
  if (pomodoro_dang_chay) {
    display.print(pomodoro_dang_nghi ? "NGHI 5 PHUT" : "POMODORO 25 PHUT");
  } else {
    display.print("POMODORO SAN SANG");
  }

  display.drawLine(0, 10, 127, 10, SSD1306_WHITE);

  display.setTextSize(3);
  display.setCursor(18, 20);
  if (phut < 10) display.print("0");
  display.print(phut);
  display.print(":");
  if (giay < 10) display.print("0");
  display.print(giay);

  display.setTextSize(1);
  display.setCursor(0, 55);
  display.print(Firebase.ready() ? "Firebase: OK" : "Firebase: ...");
  display.setCursor(86, 55);
  display.print(pomodoro_dang_chay ? "RUN" : "STOP");

  display.display();
}

void xu_ly_pomodoro() {
  if (!pomodoro_dang_chay) return;

  unsigned long con_lai = pomodoro_giay_con_lai();
  if ((int)con_lai != pomodoro_giay_con_lai_cu || millis() - thoi_gian_day_pomodoro > 1000) {
    pomodoro_giay_con_lai_cu = con_lai;
    thoi_gian_day_pomodoro = millis();
    gui_trang_thai_pomodoro_firebase(pomodoro_dang_nghi ? "BREAK" : "WORK", con_lai, true,
                                     pomodoro_dang_nghi);
  }

  if (con_lai == 0) {
    if (!pomodoro_dang_nghi) {
      gui_trang_thai_pomodoro_firebase("WORK_DONE", 0, false, false);
      canh_bao_het_gio();
      bat_dau_pomodoro_nghi();
    } else {
      ket_thuc_pomodoro();
    }
  }
}

void loop() {
  int doc_nut = digitalRead(TOUCH_PIN);
  if (doc_nut == HIGH && trang_thai_nut_cu == LOW) {
    thoi_diem_nhan = millis();
    da_xu_ly_nhan_giu = false;
    dat_lai_may_trang_thai_ranh();
  } else if (doc_nut == HIGH && trang_thai_nut_cu == HIGH) {
    if (millis() - thoi_diem_nhan >= 3000 && !da_xu_ly_nhan_giu) {
      da_xu_ly_nhan_giu = true;
      dat_lai_may_trang_thai_ranh();

      if (trang_thai_man_hinh == 0 && !pomodoro_dang_chay) {
        bat_dau_vui_d4();
      } else if (trang_thai_man_hinh == 3) {
        if (!pomodoro_dang_chay) {
          bat_dau_pomodoro_lam_viec();
        } else {
          ket_thuc_pomodoro();
        }
      }
    }
  } else if (doc_nut == LOW && trang_thai_nut_cu == HIGH) {
    if (trang_thai_vui_d4 == VUI_D4_VAY_DUOI) {
      trang_thai_vui_d4 = VUI_D4_THA_NHIN_LEN;
      moc_vui_d4 = millis();

      ve_mat_liec_len();
      servoTayTrai.write(90);
      servoTayPhai.write(90);
    } else if (!da_xu_ly_nhan_giu && (millis() - thoi_diem_nhan > 50)) {
      trang_thai_man_hinh++;
      if (trang_thai_man_hinh > 3) trang_thai_man_hinh = 0;

      can_ve_lai_ngay = true;
      dat_lai_may_trang_thai_ranh();

      Serial.print("--> Chuyen sang man hinh so: ");
      Serial.println(trang_thai_man_hinh);
    }
  }

  trang_thai_nut_cu = doc_nut;

  if (trang_thai_man_hinh == 0) {
    if (trang_thai_ranh == RANH_CHO && trang_thai_vui_d4 == VUI_D4_RANH) {
      hieu_ung_nhay_mat();
    }
  } else if (trang_thai_man_hinh == 1)
    hien_thi_thoi_tiet();
  else if (trang_thai_man_hinh == 2)
    hien_thi_dong_ho();
  else if (trang_thai_man_hinh == 3)
    hien_thi_pomodoro();

  xu_ly_vui_d4();

  xu_ly_may_trang_thai_ranh();

  xu_ly_pomodoro();

  doc_lenh_robot_tu_firebase();

  if (millis() - thoi_gian_day_firebase > 10000) {
    thoi_gian_day_firebase = millis();
    sensors_event_t humidity, temp;
    aht.getEvent(&humidity, &temp);

    if (Firebase.ready()) {
      bool ok = true;
      float nhietDo = temp.temperature;
      float doAm = humidity.relative_humidity;
      float anhSang = lightMeter.readLightLevel();
      unsigned long long espSentAt = getEpochMs();
      sensor_seq++;

      if (isfinite(nhietDo)) {
        if (!Firebase.RTDB.setFloat(&fbdo, fbPath("/ThongSo/NhietDo"), nhietDo)) {
          ok = false;
          Serial.print("Loi NhietDo: ");
          Serial.println(fbdo.errorReason());
        }
      } else {
        ok = false;
        Serial.println("Bo qua NhietDo: gia tri khong hop le");
      }

      if (isfinite(doAm)) {
        if (!Firebase.RTDB.setFloat(&fbdo, fbPath("/ThongSo/DoAm"), doAm)) {
          ok = false;
          Serial.print("Loi DoAm: ");
          Serial.println(fbdo.errorReason());
        }
      } else {
        ok = false;
        Serial.println("Bo qua DoAm: gia tri khong hop le");
      }

      if (isfinite(anhSang)) {
        if (!Firebase.RTDB.setFloat(&fbdo, fbPath("/ThongSo/AnhSang"), anhSang)) {
          ok = false;
          Serial.print("Loi AnhSang: ");
          Serial.println(fbdo.errorReason());
        }
      } else {
        ok = false;
        Serial.println("Bo qua AnhSang: gia tri khong hop le");
      }

      float apSuat = bmp.readPressure() / 100.0F;
      float doCao = bmp.readAltitude(1013.25);

      if (isfinite(apSuat) && apSuat > 0) {
        Firebase.RTDB.setFloat(&fbdo, fbPath("/ThongSo/ApSuat"), apSuat);
      }

      if (isfinite(doCao)) {
        Firebase.RTDB.setFloat(&fbdo, fbPath("/ThongSo/DoCao"), doCao);
      }

      // Dashboard tính độ trễ cảm biến từ Date.now() - espSentAt.
      Firebase.RTDB.setString(&fbdo, fbPath("/ThongSo/espSentAt"), epochMsToString(espSentAt));
      Firebase.RTDB.setInt(&fbdo, fbPath("/ThongSo/seq"), (int)sensor_seq);
      Firebase.RTDB.setString(&fbdo, fbPath("/ThongSo/robotId"), ROBOT_ID);

      Firebase.RTDB.setString(&fbdo, fbPath("/ThietBi/TrangThai"), "ONLINE");
      Firebase.RTDB.setString(&fbdo, fbPath("/ThietBi/IP"), WiFi.localIP().toString());
      Firebase.RTDB.setString(&fbdo, fbPath("/ThietBi/ManHinh"), String(trang_thai_man_hinh));
      Firebase.RTDB.setString(&fbdo, fbPath("/ThietBi/ThoiGianCapNhat"), nowEpochMsString());

      Firebase.RTDB.setString(&fbdo, fbPath("/RobotInfo/status"), "ONLINE");
      Firebase.RTDB.setString(&fbdo, fbPath("/RobotInfo/ip"), WiFi.localIP().toString());
      Firebase.RTDB.setInt(&fbdo, fbPath("/RobotInfo/lastSeen"), (int)time(nullptr));

      if (ok) {
        Serial.println("--> Da day du lieu moi truong len Firebase!");
      }
    } else {
      Serial.println("Firebase chua ready, dang cho token...");
    }
  }
}

#define ROBOT_ID "desk_robot_01"

String fbPath(const char* subPath) {
  return String("/RobotDashboard/Robots/") + ROBOT_ID + subPath;
}

// Epoch millisecond dùng chung với Date.now() trên dashboard.
// Trả về 0 khi NTP chưa đồng bộ để bỏ qua phép đo độ trễ.
unsigned long long getEpochMs() {
  struct timeval tv;
  gettimeofday(&tv, nullptr);
  if (tv.tv_sec < 1700000000) {  // Chưa có thời gian NTP hợp lệ
    return 0ULL;
  }
  return (unsigned long long)tv.tv_sec * 1000ULL + (unsigned long long)(tv.tv_usec / 1000ULL);
}

String epochMsToString(unsigned long long value) {
  char buffer[32];
  snprintf(buffer, sizeof(buffer), "%llu", value);
  return String(buffer);
}

String nowEpochMsString() { return epochMsToString(getEpochMs()); }

